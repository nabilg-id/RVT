# Konfigurasi YouTube Viral Clipper
#
# Salin file ini ke `.env` di root repo, lalu isi nilainya.
# `config.py` membaca `.env` dari root repo maupun dari dalam paket clipper.

# --- WAJIB ---
# Dipakai services/ai_selector.py untuk memilih momen clip.
# Tanpa ini, AISelector() akan melempar ValueError saat dijalankan.
OPENROUTER_API_KEY=

# Model OpenRouter.
#
# Default `openrouter/free` adalah router resmi OpenRouter ke model gratis:
# ia selalu mengarah ke model gratis yang sedang tersedia, jadi tidak perlu
# diubah saat katalog OpenRouter berubah. Dipakai untuk memilih momen clip.
#
# Kalau mau model tertentu (mis. berbasis tag `:free` atau berbayar), ganti
# di sini. Cek daftar model: https://openrouter.ai/models
# Kalau nama model salah, select_clips() tidak error: ia jatuh ke pemilihan
# acak, jadi clip tetap keluar tapi tidak hasil analisis AI.
OPENROUTER_MODEL=openrouter/free

# --- Transkripsi ---
# tiny | base | small | medium | large-v2
# large-v2 paling akurat tapi paling lambat dan paling besar (~3 GB).
WHISPER_MODEL=medium

# id | en. Kosongkan untuk deteksi otomatis.
WHISPER_LANGUAGE=id

# --- Folder ---
# Path relatif di-anchor ke root repo, bukan ke folder dari mana perintah
# dijalankan. Jadi ./clips berarti <repo>/clips dan nilainya sama dari mana
# pun aplikasi dijalankan. Path absolut juga boleh.
OUTPUT_DIR=./clips
TEMP_DIR=./temp

# --- YouTube ---
# Cookies bila YouTube memblokir unduhan.
# Pilih salah satu:
# COOKIES_FILE=./cookies.txt
# YOUTUBE_COOKIES_BROWSER=chrome
# YOUTUBE_COOKIES_CONTENT=

# User agent kustom.
# YOUTUBE_USER_AGENT=

# --- GUI web ---
RCH_HOST=127.0.0.1
RCH_PORT=8787

# Catatan: GEMINI_API_KEY tidak lagi dipakai; pemilihan momen lewat OpenRouter.